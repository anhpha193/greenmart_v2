    {
      "id": 7,
      "type": "row",
      "title": "Cluster: 4 node c7i-flex.large (Prometheus)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
