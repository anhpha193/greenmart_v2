        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (app) (label_replace(rate(container_cpu_usage_seconds_total{namespace=\"greenmart\",container!=\"\",container!=\"POD\"}[2m]), \"app\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]{5}\")) * 1000",
          "legendFormat": "{{app}}",
          "editorMode": "code",
          "range": true,
          "interval": "1m"
        }
      ],
      "fieldConfig": {
